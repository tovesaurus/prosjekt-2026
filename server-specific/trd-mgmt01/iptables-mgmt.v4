*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]
# Allow loopback
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT
# Allow established/related connections
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
# Updates and Git
-A OUTPUT -p tcp -m multiport --dports 80,443 -j ACCEPT
# DNS
-A OUTPUT -p udp -d 10.0.0.60 --dport 53 -j ACCEPT
-A OUTPUT -p tcp -d 10.0.0.60 --dport 53 -j ACCEPT
# NTP
-A OUTPUT -p udp -d 10.0.0.60 --dport 123 -j ACCEPT
# SSH to managed servers
-A OUTPUT -p tcp -d 10.0.0.62 --dport 22 -j ACCEPT
-A OUTPUT -p tcp -d 10.0.0.63 --dport 22 -j ACCEPT
# Logging
-A INPUT -m limit --limit 5/min -j LOG --log-prefix "IPT INPUT DROP: " --log-level 4
COMMIT