# Default policies
iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -P OUTPUT DROP

# Allow loopback
iptables -A INPUT -i lo -j ACCEPT
iptables -A OUTPUT -o lo -j ACCEPT

# Allow established/related connections
iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# Updates and Git
iptables -A OUTPUT -p tcp -m multiport --dports 80,443 -j ACCEPT

# DNS
iptables -A OUTPUT -p udp -d 10.0.0.60 --dport 53 -j ACCEPT
iptables -A OUTPUT -p tcp -d 10.0.0.60 --dport 53 -j ACCEPT

# NTP
iptables -A OUTPUT -p udp -d 10.0.0.60 --dport 123 -j ACCEPT

# SSH to managed servers
iptables -A OUTPUT -p tcp -d 10.0.0.62 --dport 22 -j ACCEPT
iptables -A OUTPUT -p tcp -d 10.0.0.63 --dport 22 -j ACCEPT

# Logging
iptables -A INPUT -m limit --limit 5/min  -j LOG --log-prefix "IPT INPUT DROP: " --log-level 4
